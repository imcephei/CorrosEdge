{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CrearLogGroup",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:us-east-2:<ID_CUENTA_AWS>:log-group:/aws/lambda/obtener-config-dispositivo"
    },
    {
      "Sid": "EscribirSusLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-2:<ID_CUENTA_AWS>:log-group:/aws/lambda/obtener-config-dispositivo:*"
    },
    {
      "Sid": "LeerConfiguracion",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-2:<ID_CUENTA_AWS>:table/dispositivos"
    }
  ]
}