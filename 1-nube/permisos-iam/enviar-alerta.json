{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CrearLogGroup",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:us-east-2:<ID_CUENTA_AWS>:log-group:/aws/lambda/enviar-alerta"
    },
    {
      "Sid": "EscribirSusLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-2:<ID_CUENTA_AWS>:log-group:/aws/lambda/enviar-alerta:*"
    },
    {
      "Sid": "LeerStream",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeStream",
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator"
      ],
      "Resource": "arn:aws:dynamodb:us-east-2:<ID_CUENTA_AWS>:table/resultados_corrosion/stream/*"
    },
    {
      "Sid": "ListarStreams",
      "Effect": "Allow",
      "Action": [
        "dynamodb:ListStreams"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CompararLecturas",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Query"
      ],
      "Resource": "arn:aws:dynamodb:us-east-2:<ID_CUENTA_AWS>:table/resultados_corrosion"
    },
    {
      "Sid": "LeerDispositivo",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-2:<ID_CUENTA_AWS>:table/dispositivos"
    },
    {
      "Sid": "LeerDestinatarios",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-2:<ID_CUENTA_AWS>:table/empresas"
    },
    {
      "Sid": "FirmarLecturaDeFoto",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::imagenes-corrosion-detector/paneles/*"
    },
    {
      "Sid": "EnviarCorreos",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "arn:aws:ses:us-east-2:<ID_CUENTA_AWS>:identity/*"
    }
  ]
}